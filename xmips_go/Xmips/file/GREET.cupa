~ Greet
~ 输出提示，读入名字，输出 "hello, 名字!"
~ 数据段: MSG@0, NAME@20, MSG2@60, MSG3@70
DIM MSG D20 105,110,112,117,116,32,121,111,117,114,32,110,97,109,101,58,10,0;
MOV #11 0
MOV #10 13
INT
DIM NAME D40
MOV #11 20
MOV #12 40
MOV #10 14
INT
~ 去掉 NAME 中结尾换行(10)，替换为 0 结束符
MOV #1 0
: TRIM
MOV #0 &1NAME
MOV #2 10
CMP #0 #2
JE FOUND_NL
MOV #2 0
CMP #0 #2
JE TRIM_END
INC #1
JMP TRIM
: FOUND_NL
MOV &1NAME 0
: TRIM_END
DIM MSG2 D10 10,104,101,108,108,111,44,32,0;
MOV #11 60
MOV #10 13
INT
MOV #11 20
MOV #10 13
INT
DIM MSG3 D3 33,10,0;
MOV #11 70
MOV #10 13
INT
END
