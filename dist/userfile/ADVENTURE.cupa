~ ============================================
~ ADVENTURE.cupa —— 文字冒险游戏（修复版本）
~ 
~ 游戏流程：
~   1. 显示开场剧情
~   2. 玩家选择：去左/右或休息
~   3. 不同选择导致不同结局
~   4. 支持生命值和金币系统
~ ============================================

~ 角色状态
DIM HP 10;
DIM GOLD 0;
DIM STATUS 0;        ~ 游戏状态标志: 0=进行中, 1=胜利, -1=失败

~ 游戏状态
DIM SCENE 1;
DIM GAMEOVER 0;

~ 场景文本（ASCII 编码）
~ "Welcome to Adventure Game!\n"
DIM MSG0 D35 87,101,108,99,111,109,101,32,116,111,32,65,100,118,101,110,116,117,114,101,32,71,97,109,101,33,10,0;

~ "You are in a forest.\n"
DIM MSG1 D30 89,111,117,32,97,114,101,32,105,110,32,97,32,102,111,114,101,115,116,46,10,0;

~ "1.LEFT 2.RIGHT 3.REST\n"
DIM MSG2 D30 49,46,76,69,70,84,32,50,46,82,73,71,72,84,32,51,46,82,69,83,84,10,0;

~ "Dragon appears! 1.FIGHT 2.FLEE\n"
DIM MSG3 D40 68,114,97,103,111,110,32,97,112,112,101,97,114,115,33,32,49,46,70,73,71,72,84,32,50,46,70,76,69,69,10,0;

~ "Treasure chest! 1.OPEN 2.LEAVE\n"
DIM MSG4 D40 84,114,101,97,115,117,114,101,32,99,104,101,115,116,33,32,49,46,79,80,69,78,32,50,46,76,69,65,86,69,10,0;

~ "YOU WIN! Gold:"
DIM WINMSG D25 89,79,85,32,87,73,78,33,32,71,111,108,100,58,32,0;

~ "GAME OVER! Gold:"
DIM LOSEMSG D25 71,65,77,69,32,79,86,69,82,33,32,71,111,108,100,58,32,0;

~ "You died!\n"
DIM DEADMSG D20 89,111,117,32,100,105,101,100,33,10,0;

~ 输入缓冲
DIM INBUF D20

~ ========== 主程序初始化 ==========
MOV HP 10
MOV GOLD 0
MOV STATUS 0
MOV SCENE 1
MOV GAMEOVER 0

~ 显示欢迎信息
MOV #11 10
MOV #10 13
INT

: GAME_LOOP

CMP GAMEOVER 0
JNE END_GAME

~ 场景分支
CMP SCENE 1
JE SCENE1
CMP SCENE 2
JE SCENE2
CMP SCENE 3
JE SCENE3
JMP END_GAME

~ ========== 场景1：森林 ==========
: SCENE1
MOV #11 37
MOV #10 13
INT

MOV #11 68
MOV #10 13
INT

~ 读入玩家选择
MOV #11 200
MOV #12 20
MOV #10 14
INT

MOV #0 @#11

CMP #0 49
JE S1_LEFT

CMP #0 50
JE S1_RIGHT

CMP #0 51
JE S1_REST

JMP SCENE1

: S1_LEFT
MOV SCENE 2
JMP GAME_LOOP

: S1_RIGHT
MOV SCENE 3
JMP GAME_LOOP

: S1_REST
ADD HP 2
JMP SCENE1

~ ========== 场景2：龙的挑战 ==========
: SCENE2
MOV #11 102
MOV #10 13
INT

~ 读入选择
MOV #11 200
MOV #12 20
MOV #10 14
INT

MOV #0 @#11

CMP #0 49
JE S2_FIGHT

CMP #0 50
JE S2_FLEE

JMP SCENE2

: S2_FIGHT
SUB HP 3
CMP HP 0
JB HERO_DIED

~ 战斗胜利
ADD GOLD 20
MOV STATUS 1         ~ 设置胜利标志
MOV GAMEOVER 1
JMP GAME_LOOP

: S2_FLEE
MOV SCENE 1
JMP GAME_LOOP

: HERO_DIED
MOV STATUS -1        ~ 设置失败标志
MOV GAMEOVER 1
JMP GAME_LOOP

~ ========== 场景3：宝箱 ==========
: SCENE3
MOV #11 136
MOV #10 13
INT

~ 读入选择
MOV #11 200
MOV #12 20
MOV #10 14
INT

MOV #0 @#11

CMP #0 49
JE S3_OPEN

CMP #0 50
JE S3_LEAVE

JMP SCENE3

: S3_OPEN
ADD GOLD 50
MOV STATUS 1         ~ 设置胜利标志
MOV GAMEOVER 1
JMP GAME_LOOP

: S3_LEAVE
MOV SCENE 1
JMP GAME_LOOP

~ ========== 游戏结束 ==========
: END_GAME
CMP STATUS 1
JE SHOW_WIN

~ 失败结局
MOV #11 170
MOV #10 13
INT

JMP PRINT_GOLD

: SHOW_WIN
~ 胜利结局
MOV #11 154
MOV #10 13
INT

: PRINT_GOLD
MOV #0 GOLD
CALL PRINT_NUM
MOV #13 10
HALT

~ ========== 输出数字子程序 ==========
: PRINT_NUM
MOV #1 #0
MOV #2 0

~ 检查是否为0
CMP #1 0
JNE PN_LOOP

MOV #13 48
RET

: PN_LOOP
MOV #3 #1
MOD #3 10

PUSH #3
INC #2

DIV #1 10
CMP #1 0
JNE PN_LOOP

: PN_POP
CMP #2 0
JE PN_END

POP #3
ADD #3 48
MOV #13 #3
SUB #2 1
JMP PN_POP

: PN_END
RET
END
