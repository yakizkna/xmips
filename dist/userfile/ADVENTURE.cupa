~ ============================================
~ ADVENTURE.cupa —— 文字冒险游戏
~ 
~ 游戏流程：
~   1. 显示开场剧情
~   2. 玩家在多个场景中做选择
~   3. 不同选择导致不同结局
~   4. 支持简单的战斗逻辑
~
~ 数据段布局：
~   0-9      角色状态（生命值、金币、物品）
~   10-99    场景文本和选项
~ ============================================

~ ---------- 数据定义 ----------
~ 角色状态
DIM HP 10;                   ~ 当前生命值
DIM GOLD 0;                  ~ 金币数
DIM SWORD 0;                 ~ 是否有剑(0=无,1=有)

~ 游戏状态
DIM SCENE 1;                 ~ 当前场景ID
DIM GAMEOVER 0;              ~ 游戏结束标志

~ 场景文本（ASCII码）
~ "Welcome to Adventure!\n"
DIM SCENE1 D24 87,101,108,99,111,109,101,32,116,111,32,65,100,118,101,110,116,117,114,101,33,10,0;

~ "You are in a forest.\n"
DIM DESC1 D20 89,111,117,32,97,114,101,32,105,110,32,97,32,102,111,114,101,115,116,46,10,0;

~ "1.Go LEFT  2.Go RIGHT  3.Rest\n"
DIM OPT1 D32 49,46,71,111,32,76,69,70,84,32,32,50,46,71,111,32,82,73,71,72,84,32,32,51,46,82,101,115,116,10,0;

~ "Left path - Dragon appears!\n"
DIM DESC2 D30 76,101,102,116,32,112,97,116,104,32,45,32,68,114,97,103,111,110,32,97,112,112,101,97,114,115,33,10,0;

~ "1.FIGHT  2.FLEE\n"
DIM OPT2 D16 49,46,70,73,71,72,84,32,32,50,46,70,76,69,69,10,0;

~ "Right path - Treasure chest!\n"
DIM DESC3 D31 82,105,103,104,116,32,112,97,116,104,32,45,32,84,114,101,97,115,117,114,101,32,99,104,101,115,116,33,10,0;

~ "1.Open  2.Leave\n"
DIM OPT3 D17 49,46,79,112,101,110,32,32,50,46,76,101,97,118,101,10,0;

~ "You won! Gold: "
DIM WIN_MSG D16 89,111,117,32,119,111,110,33,32,71,111,108,100,58,32,0;

~ "Game Over! Gold: "
DIM LOSE_MSG D18 71,97,109,101,32,79,118,101,114,33,32,71,111,108,100,58,32,0;

~ "You died...\n"
DIM DEAD_MSG D12 89,111,117,32,100,105,101,100,46,46,46,10,0;

~ ---------- 主程序 ----------
MOV HP 10
MOV GOLD 0
MOV SWORD 0
MOV SCENE 1
MOV GAMEOVER 0

~ 显示欢迎
MOV #11 10
MOV #10 13
INT

: MAINLOOP

CMP GAMEOVER 0
JNE ENDGAME

CMP SCENE 1
JE SCENE_1
CMP SCENE 2
JE SCENE_2
CMP SCENE 3
JE SCENE_3
JMP ENDGAME

~ ========== 场景1：森林入口 ==========
: SCENE_1
MOV #11 34
MOV #10 13
INT

MOV #11 64
MOV #10 13
INT

~ 读取输入
MOV #11 100
MOV #12 10
MOV #10 14
INT

MOV #0 @#11

CMP #0 49           ~ '1'
JE SCENE1_LEFT

CMP #0 50           ~ '2'
JE SCENE1_RIGHT

CMP #0 51           ~ '3'
JE SCENE1_REST

JMP SCENE_1

: SCENE1_LEFT
MOV SCENE 2
JMP MAINLOOP

: SCENE1_RIGHT
MOV SCENE 3
JMP MAINLOOP

: SCENE1_REST
ADD HP 2
JMP SCENE_1

~ ========== 场景2：龙的挑战 ==========
: SCENE_2
MOV #11 96
MOV #10 13
INT

MOV #11 146
MOV #10 13
INT

~ 读取输入
MOV #11 100
MOV #12 10
MOV #10 14
INT

MOV #0 @#11

CMP #0 49           ~ '1' FIGHT
JE SCENE2_FIGHT

CMP #0 50           ~ '2' FLEE
JE SCENE2_FLEE

JMP SCENE_2

: SCENE2_FIGHT
SUB HP 3
CMP HP 0
JB HERO_DEAD

ADD GOLD 20
MOV GAMEOVER 1
JMP MAINLOOP

: SCENE2_FLEE
MOV SCENE 1
JMP MAINLOOP

: HERO_DEAD
MOV GAMEOVER 1
MOV #0 0
JMP MAINLOOP

~ ========== 场景3：宝箱 ==========
: SCENE_3
MOV #11 127
MOV #10 13
INT

MOV #11 163
MOV #10 13
INT

~ 读取输入
MOV #11 100
MOV #12 10
MOV #10 14
INT

MOV #0 @#11

CMP #0 49           ~ '1' YES
JE SCENE3_OPEN

CMP #0 50           ~ '2' NO
JE SCENE3_LEAVE

JMP SCENE_3

: SCENE3_OPEN
ADD GOLD 50
MOV SWORD 1
MOV GAMEOVER 1
MOV #0 1
JMP MAINLOOP

: SCENE3_LEAVE
MOV SCENE 1
JMP MAINLOOP

~ ========== 游戏结束 ==========
: ENDGAME
CMP #0 0
JE SHOW_LOSE

~ 胜利
MOV #11 180
MOV #10 13
INT
JMP PRINT_GOLD

: SHOW_LOSE
MOV #11 196
MOV #10 13
INT

: PRINT_GOLD
CALL PRNUM
MOV #13 10
HALT
END

~ ========== 输出数字子程序 ==========
: PRNUM
MOV #1 GOLD
CMP #1 0
JNE PN_NONZERO

~ 输出 '0'
MOV #13 48
RET

: PN_NONZERO
MOV #2 #1
MOD #2 10
ADD #2 48
MOV #13 #2

DIV #1 10
CMP #1 0
JNE PN_NONZERO

RET
