~ ============================================
~ ADVENTURE.cupa —— 文字冒险游戏
~ 
~ 游戏流程：
~   1. 显示开场剧情
~   2. 玩家在多个场景中做选择
~   3. 不同选择导致不同结局
~   4. 支持回合制进度
~
~ 数据段布局：
~   0-9      角色状态（生命值、金币、物品）
~   10-19    场景编号、选择记录
~   20-99    字符串输出缓冲
~   100+     游戏数据
~ ============================================

~ ---------- 数据定义 ----------
~ 角色状态
DIM HP D2 10,0;              ~ HP[0]=当前生命值(10)  HP[1]=最大生命值
DIM GOLD 5;                  ~ 金币数
DIM SWORD 0;                 ~ 是否有剑(0=无,1=有)
DIM SHIELD 0;                ~ 是否有盾(0=无,1=有)

~ 游戏状态
DIM SCENE 1;                 ~ 当前场景ID
DIM CHOICE 0;                ~ 玩家选择(1/2/3)
DIM GAMEOVER 0;              ~ 游戏结束标志

~ 场景文本（ASCII码）
~ 场景1：森林入口 "Welcome to Adventure!\n"
DIM SCENE1 D24 87,101,108,99,111,109,101,32,116,111,32,65,100,118,101,110,116,117,114,101,33,10,0;

~ "You are in a forest. Go left or right?\n"
DIM SCENE1_TEXT D42 89,111,117,32,97,114,101,32,105,110,32,97,32,102,111,114,101,115,116,46,32,71,111,32,108,101,102,116,32,111,114,32,114,105,103,104,116,63,10,0;

~ "1. Go LEFT\n"
DIM OPT1 D11 49,46,32,71,111,32,76,69,70,84,10,0;

~ "2. Go RIGHT\n"
DIM OPT2 D12 50,46,32,71,111,32,82,73,71,72,84,10,0;

~ "3. Rest here\n"
DIM OPT3 D11 51,46,32,82,101,115,116,32,104,101,114,101,10,0;

~ 场景2：左边路径 "Left path - A dragon appears!\n"
DIM SCENE2_TEXT D30 76,101,102,116,32,112,97,116,104,32,45,32,65,32,100,114,97,103,111,110,32,97,112,112,101,97,114,115,33,10,0;

~ "Fight or Flee?\n"
DIM SCENE2_OPT D14 70,105,103,104,116,32,111,114,32,70,108,101,101,63,10,0;

~ "1. FIGHT\n"
DIM FIGHT_OPT D8 49,46,32,70,73,71,72,84,10,0;

~ "2. FLEE\n"
DIM FLEE_OPT D7 50,46,32,70,76,69,69,10,0;

~ 场景3：右边路径 "Right path - A treasure chest!\n"
DIM SCENE3_TEXT D31 82,105,103,104,116,32,112,97,116,104,32,45,32,65,32,116,114,101,97,115,117,114,101,32,99,104,101,115,116,33,10,0;

~ "Open it?\n"
DIM SCENE3_OPT D9 79,112,101,110,32,105,116,63,10,0;

~ "1. YES\n"
DIM YES_OPT D6 49,46,32,89,69,83,10,0;

~ "2. NO\n"
DIM NO_OPT D6 50,46,32,78,79,10,0;

~ 胜利信息 "You won! Final gold: "
DIM WIN_MSG D21 89,111,117,32,119,111,110,33,32,70,105,110,97,108,32,103,111,108,100,58,32,0;

~ 失败信息 "Game Over!\n"
DIM LOSE_MSG D11 71,97,109,101,32,79,118,101,114,33,10,0;

~ 空格
DIM SPACE 32;

~ 换行
DIM NEWLINE 10;

~ ---------- 主程序 ----------
~ 初始化
MOV HP 10           ~ 生命值=10
MOV GOLD 0          ~ 金币=0
MOV SWORD 0         ~ 无剑
MOV SHIELD 0        ~ 无盾
MOV SCENE 1         ~ 场景1
MOV GAMEOVER 0      ~ 游戏未结束

~ 显示欢迎信息
MOV #11 20
MOV #10 13
INT

: MAINLOOP

~ 检查游戏是否结束
CMP GAMEOVER 0
JNE ENDGAME

~ 根据场景号跳转
CMP SCENE 1
JE SCENE_1
CMP SCENE 2
JE SCENE_2
CMP SCENE 3
JE SCENE_3
JMP ENDGAME

~ ========== 场景1：森林入口 ==========
: SCENE_1
MOV #11 26          ~ 输出场景描述
MOV #10 13
INT

MOV #11 28          ~ 输出选项1
MOV #10 13
INT

MOV #11 30          ~ 输出选项2
MOV #10 13
INT

MOV #11 32          ~ 输出选项3
MOV #10 13
INT

~ 读取玩家输入
MOV #11 50
MOV #12 10
MOV #10 14
INT

MOV #0 @#11         ~ 读取输入的第一个字符

~ 判断选择
CMP #0 49           ~ ASCII '1'
JE SCENE1_LEFT

CMP #0 50           ~ ASCII '2'
JE SCENE1_RIGHT

CMP #0 51           ~ ASCII '3'
JE SCENE1_REST

JMP SCENE_1         ~ 无效选择，重新输入

: SCENE1_LEFT
MOV SCENE 2         ~ 切换到场景2
JMP MAINLOOP

: SCENE1_RIGHT
MOV SCENE 3         ~ 切换到场景3
JMP MAINLOOP

: SCENE1_REST
ADD HP 2            ~ 恢复2点生命值
JMP SCENE_1         ~ 留在场景1

~ ========== 场景2：龙的挑战 ==========
: SCENE_2
MOV #11 34          ~ 输出场景描述
MOV #10 13
INT

MOV #11 36          ~ 输出选项
MOV #10 13
INT

MOV #11 38          ~ 输出选项1
MOV #10 13
INT

MOV #11 40          ~ 输出选项2
MOV #10 13
INT

MOV #11 50
MOV #12 10
MOV #10 14
INT

MOV #0 @#11

CMP #0 49           ~ ASCII '1' FIGHT
JE SCENE2_FIGHT

CMP #0 50           ~ ASCII '2' FLEE
JE SCENE2_FLEE

JMP SCENE_2

: SCENE2_FIGHT
~ 战斗逻辑：生命值 -= 3
SUB HP 3
CMP HP 0
JB HERO_DEAD       ~ 如果生命值<=0，死亡

~ 战斗胜利，获得金币
ADD GOLD 20
MOV GAMEOVER 1
JMP MAINLOOP

: SCENE2_FLEE
~ 逃跑，返回场景1
MOV SCENE 1
JMP MAINLOOP

: HERO_DEAD
MOV GAMEOVER 1     ~ 游戏结束（失败）
MOV #0 0           ~ 标记为失败
JMP MAINLOOP

~ ========== 场景3：宝箱 ==========
: SCENE_3
MOV #11 42          ~ 输出场景描述
MOV #10 13
INT

MOV #11 44          ~ 输出选项
MOV #10 13
INT

MOV #11 46          ~ 输出选项1
MOV #10 13
INT

MOV #11 48          ~ 输出选项2
MOV #10 13
INT

MOV #11 50
MOV #12 10
MOV #10 14
INT

MOV #0 @#11

CMP #0 49           ~ ASCII '1' YES
JE SCENE3_OPEN

CMP #0 50           ~ ASCII '2' NO
JE SCENE3_LEAVE

JMP SCENE_3

: SCENE3_OPEN
~ 打开宝箱，获得金币和剑
ADD GOLD 50
MOV SWORD 1
MOV GAMEOVER 1     ~ 游戏结束（胜利）
MOV #0 1           ~ 标记为胜利
JMP MAINLOOP

: SCENE3_LEAVE
~ 离开，返回场景1
MOV SCENE 1
JMP MAINLOOP

~ ========== 游戏结束 ==========
: ENDGAME
MOV #11 52         ~ 输出胜利信息
MOV #10 13
INT

~ 输出最终金币数
CALL PRINT_NUMBER

HALT
END
