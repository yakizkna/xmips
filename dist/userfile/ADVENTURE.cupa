~ ============================================
~ ADVENTURE.cupa —— 文字冒险游戏（网页版精简，适配代码区上限）
~
~ 游戏流程：
~   1. 显示开场剧情
~   2. 玩家选择：去左/右或休息
~   3. 不同选择导致不同结局
~   4. 支持生命值系统（为压缩体积，金币仅内部记账、不显示）
~ 说明：网页版 xmips-plus 的代码缓冲区上限约 87 条指令，故去掉 PRINT_NUM
~       子程序与金币显示，并把森林场景的两段文本合并为一次 INT 13 输出。
~       数据段地址随声明顺序自动排布（标量各占 1 字）：
~       HP=0 STATUS=1 SCENE=2 GAMEOVER=3 | MSG0=4 MSG1=39 MSG3=99 MSG4=139
~       WINMSG=179 LOSEMSG=204 INBUF=229
~ ============================================

~ 角色状态（标量各占 1 字，从 0 开始顺序排布）
DIM HP 10;
DIM STATUS 0;        ~ 游戏状态标志: 0=进行中, 1=胜利, -1=失败
DIM SCENE 1;
DIM GAMEOVER 0;

~ 场景文本（ASCII 编码）
~ "Welcome to Adventure Game!\n"
DIM MSG0 D35 87,101,108,99,111,109,101,32,116,111,32,65,100,118,101,110,116,117,114,101,32,71,97,109,101,33,10,0;

~ "You are in a forest.\n1.LEFT 2.RIGHT 3.REST\n"
DIM MSG1 D60 89,111,117,32,97,114,101,32,105,110,32,97,32,102,111,114,101,115,116,46,10,49,46,76,69,70,84,32,50,46,82,73,71,72,84,32,51,46,82,69,83,84,10,0;

~ "Dragon appears! 1.FIGHT 2.FLEE\n"
DIM MSG3 D40 68,114,97,103,111,110,32,97,112,112,101,97,114,115,33,32,49,46,70,73,71,72,84,32,50,46,70,76,69,69,10,0;

~ "Treasure chest! 1.OPEN 2.LEAVE\n"
DIM MSG4 D40 84,114,101,97,115,117,114,101,32,99,104,101,115,116,33,32,49,46,79,80,69,78,32,50,46,76,69,65,86,69,10,0;

~ "YOU WIN!\n"
DIM WINMSG D25 89,79,85,32,87,73,78,33,10,0;

~ "GAME OVER!\n"
DIM LOSEMSG D25 71,65,77,69,32,79,86,69,82,33,10,0;

~ 输入缓冲
DIM INBUF D20

~ ========== 主程序初始化 ==========
MOV HP 10
MOV SCENE 1

~ 显示欢迎信息（MSG0 地址=4）
MOV #11 4
MOV #10 13
INT

: GAME_LOOP
CMP GAMEOVER 0
JNE END_GAME

~ 场景分支
CMP SCENE 1
JE SCENE1
CMP SCENE 2
JE SCENE2
CMP SCENE 3
JE SCENE3
JMP END_GAME

~ ========== 场景1：森林 ==========
: SCENE1
MOV #11 39
MOV #10 13
INT
CALL READ_CHOICE
CMP #0 49
JE S1_LEFT
CMP #0 50
JE S1_RIGHT
CMP #0 51
JE S1_REST
JMP SCENE1

: S1_LEFT
MOV SCENE 2
JMP GAME_LOOP

: S1_RIGHT
MOV SCENE 3
JMP GAME_LOOP

: S1_REST
ADD HP 2
JMP SCENE1

~ ========== 场景2：龙的挑战 ==========
: SCENE2
MOV #11 99
MOV #10 13
INT
CALL READ_CHOICE
CMP #0 49
JE S2_FIGHT
CMP #0 50
JE S2_FLEE
JMP SCENE2

: S2_FIGHT
SUB HP 3
CMP HP 0
JB HERO_DIED
MOV STATUS 1
MOV GAMEOVER 1
JMP GAME_LOOP

: S2_FLEE
MOV SCENE 1
JMP GAME_LOOP

: HERO_DIED
MOV STATUS -1
MOV GAMEOVER 1
JMP GAME_LOOP

~ ========== 场景3：宝箱 ==========
: SCENE3
MOV #11 139
MOV #10 13
INT
CALL READ_CHOICE
CMP #0 49
JE S3_OPEN
CMP #0 50
JE S3_LEAVE
JMP SCENE3

: S3_OPEN
MOV STATUS 1
MOV GAMEOVER 1
JMP GAME_LOOP

: S3_LEAVE
MOV SCENE 1
JMP GAME_LOOP

~ ========== 游戏结束 ==========
: END_GAME
CMP STATUS 1
JE SHOW_WIN
MOV #11 204
JMP DO_PRINT
: SHOW_WIN
MOV #11 179
: DO_PRINT
MOV #10 13
INT
HALT

~ ========== 读取单个选择字符（每次 1 字节，跳过残留换行） ==========
: READ_CHOICE
MOV #11 250
MOV #12 1
MOV #10 14
INT
MOV #0 @#11
CMP #13 0
JE RC_RET
CMP #0 10
JE READ_CHOICE
: RC_RET
RET

END
