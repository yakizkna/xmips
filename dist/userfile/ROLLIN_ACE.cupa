~ ============================================================
~ REVERSAL.cupa —— 九下追分（RA REVERSE）
~ 开局 0-2 落后，九下面临无人出局。
~ 每次打席掷骰：OUT x6 / 1B x3 / 2B x2 / 3B x1 / HR x1（共 13）
~ 每球更新垒况与比分；
~   3 出局          -> 失败
~   得分反超(>=3)   -> 逆转取胜
~ 运行：xmips ROLLIN_ACE.cupa
~   逐步推进：每局打印 HIT? 等待回车/任意键后掷一球并更新局面。
~   （默认固定随机种子；若要变种子，先按任意键+回车用首字符做种子，
~     或 echo x | xmips ROLLIN_ACE.cupa 用首个字符做种子）
~ ============================================================

~ ---- 状态变量（数据段自动编址，各占 1 字）----
DIM OUTS 0;
DIM RUNS 0;
DIM B1 0;
DIM B2 0;
DIM B3 0;
DIM SEED 1234567;

~ ---- 消息（ASCII，以 0 结尾）----
DIM T0 D24 62,62,32,82,69,86,69,82,83,69,32,40,48,45,50,41,32,60,60,10,0;
DIM OM_OUT D12 83,84,82,73,75,69,47,79,85,84,0;
DIM OM_1B D8 83,73,78,71,76,69,0;
DIM OM_2B D8 68,79,85,66,76,69,0;
DIM OM_3B D8 84,82,73,80,76,69,0;
DIM OM_HR D12 72,79,77,69,32,82,85,78,33,0;
DIM S1 D8 32,79,85,84,83,61,0;
DIM S2 D8 32,82,85,78,83,61,0;
DIM S3 D8 32,66,65,83,69,83,61,0;
DIM S4 D3 10,0;
DIM M_WIN D24 62,62,62,32,67,79,77,69,66,65,67,75,32,87,73,78,33,32,60,60,60,10,0;
DIM M_LOSE D24 62,62,62,32,51,32,79,85,84,83,32,45,32,76,79,83,84,32,60,60,60,10,0;
DIM SEEDIN D2;
DIM HITP D6 72,73,84,63,32,0;   ~ "HIT? "

~ ---- 初始化：打印标题 ----
LEA #11 T0
MOV #10 13
INT

~ ---- 可选：读 1 字节做随机种子（EOF 则用默认） ----
LEA #11 SEEDIN
MOV #12 1
MOV #10 14
INT
CMP #13 0
JE MAIN_LOOP
MOV #2 SEEDIN
ADD SEED #2

~ ---- 主循环 ----
: MAIN_LOOP
CMP RUNS 3
JA DO_WIN
CMP RUNS 3
JE DO_WIN
CMP OUTS 3
JA DO_LOSE
CMP OUTS 3
JE DO_LOSE

CALL WAIT_HIT
CALL ROLL
CALL MAP_POWER
CALL PRINT_OUT
CALL APPLY_POWER
CALL SHOW_SIT

JMP MAIN_LOOP

~ ---- 终局 ----
: DO_WIN
LEA #11 M_WIN
MOV #10 13
INT
HALT
: DO_LOSE
LEA #11 M_LOSE
MOV #10 13
INT
HALT

~ ---- 等待 HIT（打印提示，读 1 字节阻塞直到回车/任意键）----
: WAIT_HIT
LEA #11 HITP
MOV #10 13
INT
LEA #11 SEEDIN
MOV #12 1
MOV #10 14
INT
RET

~ ---- 掷骰：LCG 伪随机，返回 #0 = 0..12 ----
: ROLL
MOV #2 SEED
MUL #2 1103515245
ADD #2 12345
MOV SEED #2
SHR #2 8
AND #2 65535
MOV #3 #2
DIV #3 13       ~ #0 = 余数(0..12)
RET

~ ---- 结果映射：#0 -> #5 力量(0=OUT 1=1B 2=2B 3=3B 4=HR) ----
: MAP_POWER
CMP #0 6
JB MP_OUT
CMP #0 9
JB MP_1B
CMP #0 11
JB MP_2B
CMP #0 12
JB MP_3B
MOV #5 4
JMP MP_DONE
: MP_OUT
MOV #5 0
JMP MP_DONE
: MP_1B
MOV #5 1
JMP MP_DONE
: MP_2B
MOV #5 2
JMP MP_DONE
: MP_3B
MOV #5 3
: MP_DONE
RET

~ ---- 打印打席结果（按 #5）----
: PRINT_OUT
MOV #10 13
CMP #5 0
JE PO_OUT
CMP #5 1
JE PO_1B
CMP #5 2
JE PO_2B
CMP #5 3
JE PO_3B
LEA #11 OM_HR
JMP PO_GO
: PO_OUT
LEA #11 OM_OUT
JMP PO_GO
: PO_1B
LEA #11 OM_1B
JMP PO_GO
: PO_2B
LEA #11 OM_2B
JMP PO_GO
: PO_3B
LEA #11 OM_3B
: PO_GO
INT
RET

~ ---- 应用打席结果（按 #5），#6/7/8=新垒 #9=本轮得分 ----
: APPLY_POWER
CMP #5 0
JE AP_OUT
MOV #6 0
MOV #7 0
MOV #8 0
MOV #9 0
CMP B3 0
JE AP_B2
INC #9          ~ 三垒跑者必得分
: AP_B2
CMP B2 0
JE AP_B1
CMP #5 1
JE AP_B2_3B
INC #9          ~ 二垒跑者：P>=2 得分
JMP AP_B1
: AP_B2_3B
MOV #8 1        ~ 二垒跑者单打推进三垒
: AP_B1
CMP B1 0
JE AP_BAT
CMP #5 1
JE AP_B1_2B
CMP #5 2
JE AP_B1_3B
INC #9          ~ 一垒跑者：P>=3 得分
JMP AP_BAT
: AP_B1_2B
MOV #7 1
JMP AP_BAT
: AP_B1_3B
MOV #8 1
: AP_BAT
CMP #5 4
JE AP_HR
CMP #5 3
JE AP_TRI
CMP #5 2
JE AP_DBL
MOV #6 1        ~ 打者上一垒
JMP AP_WRITE
: AP_DBL
MOV #7 1
JMP AP_WRITE
: AP_TRI
MOV #8 1
JMP AP_WRITE
: AP_HR
INC #9          ~ 全垒打本垒得一分
: AP_WRITE
MOV B1 #6
MOV B2 #7
MOV B3 #8
MOV #1 RUNS
ADD #1 #9
MOV RUNS #1
RET
: AP_OUT
MOV #1 OUTS
INC #1
MOV OUTS #1
RET

~ ---- 展示局面：OUTS=.. RUNS=.. BASES=... ----
: SHOW_SIT
MOV #10 13
LEA #11 S1
INT
MOV #4 OUTS
CALL PRINT_DIGIT
LEA #11 S2
INT
MOV #4 RUNS
CALL PRINT_NUM
LEA #11 S3
INT
MOV #4 B1
CALL PRINT_DIGIT
MOV #4 B2
CALL PRINT_DIGIT
MOV #4 B3
CALL PRINT_DIGIT
LEA #11 S4
INT
RET

~ ---- 打印一位数字（#4 -> 字符输出）----
: PRINT_DIGIT
ADD #4 48
MOV #13 #4
RET

~ ---- 打印 0..99（#4 -> 十进制，多位）----
: PRINT_NUM
MOV #3 #4
MOV #2 0
: PN_LP
CMP #3 10
JB PN_DONE
SUB #3 10
INC #2
JMP PN_LP
: PN_DONE
CMP #2 0
JE PN_UNITS
MOV #1 #2
ADD #1 48
MOV #13 #1
: PN_UNITS
MOV #1 #3
ADD #1 48
MOV #13 #1
RET

END