~ ============================================================
~ ROLLIN_ACE.cupa —— 九下追分（RA REVERSE，含好坏球）
~ 开局 YOU 0 - X OPP，X 由玩家输入，九下面临无人出局。
~ 每球好/坏由随机决定（玩家看不到）；选择：
~   H -> HIT（挥棒）   L -> LAY OFF（看球）
~   好球+挥棒 -> 进入击球结果（挥空x3 OUTx6 1Bx3 2Bx2 3Bx1 HRx1）
~   看坏球 -> 坏数+1（4 坏 -> 保送）
~   看好球 / 挥到坏球 -> 好数+1（3 好 -> 三振出局）
~ 终局：3 出局 -> LOST；得分反超(>OPP) -> 逆转取胜
~ 运行：xmips ROLLIN_ACE.cupa
~ ============================================================

~ ---- 状态变量 ----
DIM OUTS 0;
DIM RUNS 0;
DIM B1 0;
DIM B2 0;
DIM B3 0;
DIM SEED 1234567;
DIM STRIKES 0;
DIM BALLS 0;
DIM PITCHN 0;
DIM OPP_SCORE 2;
DIM KEYB D11;
DIM DUMB D2;
DIM READBUF D10;

~ ---- 消息（ASCII，以 0 结尾）----
DIM TITLE1 D33 62,62,32,82,79,76,76,73,78,32,65,67,69,32,91,67,85,80,65,32,86,69,82,83,73,79,78,93,32,60,60,10,0;
~ ">> ROLLIN ACE [CUPA VERSION] <<\n"
DIM TITLE2_PFX D24 62,62,32,57,84,72,32,66,79,84,84,79,77,44,32,89,79,85,32,48,32,45,32,0;
~ ">> 9TH BOTTOM, YOU 0 - "
DIM TITLE2_SFX D10 32,79,80,80,32,60,60,10,0;
~ " OPP <<\n"
DIM TITLE3 D30 62,62,32,82,69,86,69,82,83,69,32,66,69,70,79,82,69,32,51,32,79,85,84,83,33,32,60,60,10,0;
~ ">> REVERSE BEFORE 3 OUTS! <<\n"
~ ---- 结果字符串（末尾不带 \n，由 PRINT_SCORE 补比分+\n）----
DIM LM_BALL D8 62,62,32,66,65,76,76,0;              ~ ">> BALL"
DIM LSTR D10 62,62,32,83,84,82,73,75,69,0;         ~ ">> STRIKE"
DIM LMISS D8 62,62,32,77,73,83,83,0;               ~ ">> MISS"
DIM LOUT D8 62,62,32,79,85,84,33,0;                 ~ ">> OUT!"
DIM LSINGLE D10 62,62,32,83,73,78,71,76,69,0;      ~ ">> SINGLE"
DIM LDOUBLE D10 62,62,32,68,79,85,66,76,69,0;      ~ ">> DOUBLE"
DIM LTRIPLE D10 62,62,32,84,82,73,80,76,69,0;      ~ ">> TRIPLE"
DIM LHR D12 62,62,32,72,79,77,69,32,82,85,78,0;    ~ ">> HOME RUN"
DIM LSO D15 62,62,32,83,84,82,73,75,69,32,79,85,84,33,0; ~ ">> STRIKE OUT!"
DIM LBB D8 62,62,32,87,65,76,75,0;                 ~ ">> WALK"

~ ---- 比分 ----
DIM SC_PFX D8 32,40,32,89,79,85,32,0;               ~ " (YOU "
DIM SC_MID D4 32,45,32,0;                            ~ " - "
DIM SC_SFX D7 32,79,80,80,41,10,0;                  ~ " OPP)\n"

DIM SET_OPP D20 83,69,84,32,83,67,79,82,69,32,79,70,32,79,80,80,58,32,10,0;
~ "SET SCORE OF OPP: \n"
DIM SET_SEED D20 83,69,84,32,83,69,69,68,32,79,70,32,82,65,78,68,58,32,10,0;
~ "SET SEED OF RAND: \n"
DIM PM D24 72,73,84,32,79,82,32,76,65,89,32,79,70,70,32,40,72,47,76,41,58,32,10,0;
~ "HIT OR LAY OFF (H/L): \n"
DIM LBCNT D6 66,65,76,76,61,0;               ~ "BALL="
DIM LSCNT D9 32,83,84,82,73,75,69,61,0;      ~ " STRIKE="
DIM S1 D6 32,79,85,84,61,0;                  ~ " OUT="
DIM S3 D7 32,66,65,83,69,61,0;               ~ " BASE="
DIM S4 D3 10,0;
DIM M_WIN D24 62,62,62,32,67,79,77,69,66,65,67,75,32,87,73,78,33,32,60,60,60,10,0;
DIM M_LOSE D24 62,62,62,32,51,32,79,85,84,83,32,45,32,76,79,83,84,32,60,60,60,10,0;

~ ---- 初始化 ----
LEA #11 TITLE1
MOV #10 13
INT

LEA #11 SET_OPP
MOV #10 13
INT
CALL READ_NUM
CMP #4 0
JNE SAVE_OPP
MOV #4 3              ~ 默认 OPP_SCORE=3
: SAVE_OPP
MOV OPP_SCORE #4

LEA #11 SET_SEED
MOV #10 13
INT
CALL READ_NUM
CMP #4 0
JNE SAVE_SEED
MOV #4 99             ~ 默认 SEED=99
: SAVE_SEED
MOV SEED #4

~ 动态标题：>> 9TH BOTTOM, YOU 0 - N OPP <<\n
LEA #11 TITLE2_PFX
MOV #10 13
INT
MOV #4 OPP_SCORE
CALL PRINT_NUM
LEA #11 TITLE2_SFX
MOV #10 13
INT

LEA #11 TITLE3
MOV #10 13
INT

~ ---- 主循环 ----
: MAIN_LOOP
CMP RUNS OPP_SCORE
JA DO_WIN
JE DO_WIN
CMP OUTS 3
JA DO_LOSE
JE DO_LOSE

CALL PITCH_SEL

LEA #11 PM
MOV #10 13
INT
LEA #11 KEYB
MOV #12 1
MOV #10 14
INT

MOV #3 KEYB
CMP #3 10
JE ML_HIT_ENTER
CMP #3 13
JE ML_HIT_ENTER
CALL DISCARD_BYTE
JMP ML_NE
: ML_HIT_ENTER
MOV KEYB 72          ~ 回车 → 当作 'H'
MOV #3 72
: ML_NE
CMP PITCHN 1
JE ML_STRIKE

~ ---- 坏球 ----
CMP #3 72
JE ML_SWING_BALL
CMP #3 104
JE ML_SWING_BALL
~ LAY OFF 坏球
MOV #1 BALLS
INC #1
MOV BALLS #1
CMP BALLS 4
JB LO_BAD
CALL APPLY_WALK
LEA #11 LBB
MOV #10 13
INT
CALL PRINT_SCORE
CALL RESET_BC
CALL SHOW_STATE
JMP MAIN_LOOP
: LO_BAD
LEA #11 LM_BALL
MOV #10 13
INT
CALL PRINT_SCORE
CALL SHOW_STATE
JMP MAIN_LOOP

~ ---- 挥棒 + 坏球 ----
: ML_SWING_BALL
MOV #1 STRIKES
INC #1
MOV STRIKES #1
CMP STRIKES 3
JB MS_BAD
LEA #11 LSO
MOV #10 13
INT
CALL PRINT_SCORE
CALL RESET_BC
CALL SHOW_STATE
JMP MAIN_LOOP
: MS_BAD
LEA #11 LMISS
MOV #10 13
INT
CALL PRINT_SCORE
CALL SHOW_STATE
JMP MAIN_LOOP

~ ---- 好球 ----
: ML_STRIKE
CMP #3 72
JE ML_SWING_STR
CMP #3 104
JE ML_SWING_STR
~ LAY OFF 好球
MOV #1 STRIKES
INC #1
MOV STRIKES #1
CMP STRIKES 3
JB LO_STR
LEA #11 LSO
MOV #10 13
INT
CALL PRINT_SCORE
CALL RESET_BC
CALL SHOW_STATE
JMP MAIN_LOOP
: LO_STR
LEA #11 LSTR
MOV #10 13
INT
CALL PRINT_SCORE
CALL SHOW_STATE
JMP MAIN_LOOP

~ ---- 挥棒 + 好球 ----
: ML_SWING_STR
CALL SWING_HIT
CALL SHOW_STATE
JMP MAIN_LOOP

~ ---- 终局 ----
: DO_WIN
LEA #11 M_WIN
MOV #10 13
INT
HALT
: DO_LOSE
LEA #11 M_LOSE
MOV #10 13
INT
HALT

~ ---- 投球 ----
: PITCH_SEL
CALL ROLL16
CMP #0 8
JB PSS_STR
MOV PITCHN 0
RET
: PSS_STR
MOV PITCHN 1
RET

~ ---- 吞掉 1 字节 ----
: DISCARD_BYTE
LEA #11 DUMB
MOV #12 1
MOV #10 14
INT
RET

~ ---- 掷骰 0..15 ----
: ROLL16
MOV #2 SEED
MUL #2 1103515245
ADD #2 12345
MOV SEED #2
SHR #2 8
AND #2 65535
MOV #3 #2
DIV #3 16
RET

~ ---- 归零好/坏数 ----
: RESET_BC
MOV STRIKES 0
MOV BALLS 0
RET

~ ---- 挥棒击球 ----
: SWING_HIT
CALL ROLL16
CMP #0 3
JB SW_MISS
CMP #0 9
JB SW_OUT
MOV #5 1
CMP #0 12
JB SW_HIT
MOV #5 2
CMP #0 14
JB SW_HIT
MOV #5 3
CMP #0 15
JB SW_HIT
MOV #5 4
JMP SW_HIT
: SW_MISS
MOV #1 STRIKES
INC #1
MOV STRIKES #1
CMP STRIKES 3
JB SM_NORMAL
LEA #11 LSO
MOV #10 13
INT
CALL PRINT_SCORE
CALL RESET_BC
RET
: SM_NORMAL
LEA #11 LMISS
MOV #10 13
INT
CALL PRINT_SCORE
RET
: SW_OUT
MOV #1 OUTS
INC #1
MOV OUTS #1
LEA #11 LOUT
MOV #10 13
INT
CALL PRINT_SCORE
CALL RESET_BC
RET
: SW_HIT
CALL APPLY_POWER
CALL PRNT_SWING
CALL RESET_BC
RET

~ ---- 打印击球结果 ----
: PRNT_SWING
MOV #10 13
CMP #5 1
JE PS1B
CMP #5 2
JE PS2B
CMP #5 3
JE PS3B
LEA #11 LHR
JMP PSGO
: PS1B
LEA #11 LSINGLE
JMP PSGO
: PS2B
LEA #11 LDOUBLE
JMP PSGO
: PS3B
LEA #11 LTRIPLE
: PSGO
INT
CALL PRINT_SCORE
RET

~ ---- 保送推进 ----
: APPLY_WALK
MOV #9 0
CMP B1 0
JE AW_PB
CMP B2 0
JE AW_PB2
CMP B3 0
JE AW_BOSS
INC #9
MOV #8 1
MOV #7 1
MOV #6 1
JMP AW_WRITE
: AW_BOSS
MOV #8 1
MOV #7 1
MOV #6 1
JMP AW_WRITE
: AW_PB2
MOV #8 B3
MOV #7 1
MOV #6 1
JMP AW_WRITE
: AW_PB
MOV #8 B3
MOV #7 B2
MOV #6 1
: AW_WRITE
MOV B1 #6
MOV B2 #7
MOV B3 #8
MOV #1 RUNS
ADD #1 #9
MOV RUNS #1
RET

~ ---- 应用安打结果 ----
: APPLY_POWER
MOV #6 0
MOV #7 0
MOV #8 0
MOV #9 0
CMP B3 0
JE AP_B2
INC #9
: AP_B2
CMP B2 0
JE AP_B1
CMP #5 1
JE AP_B2_3B
INC #9
JMP AP_B1
: AP_B2_3B
MOV #8 1
: AP_B1
CMP B1 0
JE AP_BAT
CMP #5 1
JE AP_B1_2B
CMP #5 2
JE AP_B1_3B
INC #9
JMP AP_BAT
: AP_B1_2B
MOV #7 1
JMP AP_BAT
: AP_B1_3B
MOV #8 1
: AP_BAT
CMP #5 4
JE AP_HR
CMP #5 3
JE AP_TRI
CMP #5 2
JE AP_DBL
MOV #6 1
JMP AP_WRITE
: AP_DBL
MOV #7 1
JMP AP_WRITE
: AP_TRI
MOV #8 1
JMP AP_WRITE
: AP_HR
INC #9
: AP_WRITE
MOV B1 #6
MOV B2 #7
MOV B3 #8
MOV #1 RUNS
ADD #1 #9
MOV RUNS #1
RET

~ ---- 打印比分：" (YOU <RUNS> - <OPP_SCORE> OPP)\n" ----
: PRINT_SCORE
MOV #10 13
LEA #11 SC_PFX
INT
MOV #4 RUNS
CALL PRINT_NUM
LEA #11 SC_MID
INT
MOV #4 OPP_SCORE
CALL PRINT_NUM
LEA #11 SC_SFX
INT
RET

~ ---- 读十进制整数到 #4 ----
: READ_NUM
MOV #4 0
: RN_LOOP
LEA #11 READBUF
MOV #12 1
MOV #10 14
INT
LEA #7 READBUF
MOV #3 @#7
CMP #3 10
JE RN_DONE
CMP #3 13
JE RN_DONE
CMP #3 48
JB RN_DONE
CMP #3 57
JA RN_DONE
SUB #3 48
MOV #2 #4
MUL #2 10
ADD #2 #3
MOV #4 #2
JMP RN_LOOP
: RN_DONE
RET

~ ---- 状态行 ----
: SHOW_STATE
MOV #10 13
LEA #11 LBCNT
INT
MOV #4 BALLS
CALL PRINT_DIGIT
LEA #11 LSCNT
INT
MOV #4 STRIKES
CALL PRINT_DIGIT
LEA #11 S1
INT
MOV #4 OUTS
CALL PRINT_DIGIT
LEA #11 S3
INT
MOV #4 B1
CALL PRINT_DIGIT
MOV #4 B2
CALL PRINT_DIGIT
MOV #4 B3
CALL PRINT_DIGIT
LEA #11 S4
INT
RET

~ ---- 打印一位数字 ----
: PRINT_DIGIT
ADD #4 48
MOV #13 #4
RET

~ ---- 打印 0..99 ----
: PRINT_NUM
MOV #3 #4
MOV #2 0
: PN_LP
CMP #3 10
JB PN_DONE
SUB #3 10
INC #2
JMP PN_LP
: PN_DONE
CMP #2 0
JE PN_UNITS
MOV #1 #2
ADD #1 48
MOV #13 #1
: PN_UNITS
MOV #1 #3
ADD #1 48
MOV #13 #1
RET

END
