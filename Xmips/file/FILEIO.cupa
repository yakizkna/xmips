~ 文件系统调度测试（dispatcher 原生 INT 15~18）
~ 数据段布局:
~   0..8    PATH   "test.txt\0"     -> 116,101,115,116,46,116,120,116,0
~   9..20   SBUF   "hello file\n\0" -> 104,101,108,108,111,32,102,105,108,101,10,0
~   21..60  RBUF   读回缓冲
DIM PATH D9 116,101,115,116,46,116,120,116,0;
DIM SBUF D12 104,101,108,108,111,32,102,105,108,101,10,0;
DIM RBUF D40

~ ---- open 写入模式 ----
MOV #11 0
MOV #12 1
MOV #10 15
INT
MOV #1 #9          ~ 保存 fd 到 #1

~ ---- write: 从 SBUF(地址9) 写 11 字节 ----
MOV #11 9
MOV #12 11
MOV #9 #1
MOV #10 17
INT

~ ---- close ----
MOV #9 #1
MOV #10 18
INT

~ ---- reopen 读模式 ----
MOV #11 0
MOV #12 0
MOV #10 15
INT
MOV #1 #9

~ ---- read: 从 RBUF(地址21) 读最多 40 ----
MOV #11 21
MOV #12 40
MOV #9 #1
MOV #10 16
INT

~ ---- INT 13 输出读回内容（读到 0 结束）----
MOV #11 21
MOV #10 13
INT

~ ---- close ----
MOV #9 #1
MOV #10 18
INT
END